{
  "name": "@xiciyang/inference-tuning",
  "version": "0.1.0",
  "description": "根因墙驱动的推理调优插件：诊断瓶颈墙 → 匹配 TOP1 干预 → 性能与精度双闭环验证 → 通过则输出可复用配置，失败则自动回退",
  "type": "module",
  "license": "Apache-2.0",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./api": "./src/api.mjs",
    "./mcp": "./mcp/server.mjs"
  },
  "bin": {
    "inference-tuning": "bin/inference-tuning.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "mcp/",
    "skills/",
    "docs/parity-contract.md",
    "manifest.yaml",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "TEST_REPORT.md",
    "docs/audit-sample/"
  ],
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" \"tests/integration/*.test.mjs\"",
    "test:contract": "npm run test:parity-contract && node ../inference-contracts/checks/run-all.mjs",
    "check": "node scripts/check-manifest.mjs",
    "e2e": "node scripts/e2e-demo.mjs",
    "install-skills": "node bin/inference-tuning.mjs install-skills",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:parity-contract": "node --test \"tests/contract/*.test.mjs\""
  },
  "dependencies": {},
  "engines": {
    "dsh": ">=0.2.0 <0.3.0",
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "inference",
    "tuning",
    "vllm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiciyang/inference-tuning.git"
  },
  "homepage": "https://github.com/xiciyang/inference-tuning#readme",
  "bugs": {
    "url": "https://github.com/xiciyang/inference-tuning/issues"
  }
}
